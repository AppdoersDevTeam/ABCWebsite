# Environment variable names only. Copy to `.env` and fill in real values.
# Never commit `.env`.

VITE_SITE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_YOUTUBE_API_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_GITHUB_REPO=
VITE_GITHUB_TOKEN=
# Web Push public key (safe to expose). Private key is a Supabase Edge Function secret.
VITE_VAPID_PUBLIC_KEY=
# Optional. If unset, the MFA Edge Function derives a key from SUPABASE_SERVICE_ROLE_KEY.
# MFA_ENCRYPTION_KEY=
GEMINI_API_KEY=

# Appdoers Hub token is per laptop, not committed here.
# Run: node tools/setup-hub-token.mjs
# Saved to %USERPROFILE%\.appdoers\hub.env (or ~/.appdoers/hub.env)
# APPDOERS_HUB_URL=
# APPDOERS_CURSOR_TOKEN=
