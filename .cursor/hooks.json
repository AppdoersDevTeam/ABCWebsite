{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/require-hub-ticket.mjs",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/hooks/hub-session-start.mjs",
        "failClosed": false
      }
    ]
  }
}
